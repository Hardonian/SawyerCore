# =============================================================================
# SawyerCore Environment Configuration
# =============================================================================
# Copy to .env and adjust for your setup.
# All variables use the SAWYER_ prefix for consistency.
# See QUICKSTART.md for setup instructions.
# =============================================================================

# --- Server Binding ---
# Host and port for the Sawyer HTTP API server
SAWYER_BIND_HOST=127.0.0.1
SAWYER_PORT=8787

# --- Runtime Mode ---
# Options: tiny, local, performance, gateway, dev
# Default: local-safe (localhost-only, no cloud fallback)
SAWYER_MODE=local-safe
SAWYER_PROFILE=local-safe
SAWYER_PRIVATE_MODE=true
SAWYER_CLOUD_FALLBACK=false

# --- Data & State ---
# SAWYER_DATA_DIR=./data
# SAWYER_STATE_DIR=.sawyer

# --- Local Providers (vLLM) ---
SAWYER_VLLM_ENABLED=true
SAWYER_VLLM_BASE_URL=http://127.0.0.1:8000/v1
SAWYER_VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# --- Local Providers (LiteLLM) ---
SAWYER_LITELLM_ENABLED=true
SAWYER_LITELLM_BASE_URL=http://127.0.0.1:4000/v1
SAWYER_LITELLM_MODEL=local-qwen

# --- Local Providers (llama.cpp) ---
SAWYER_LLAMACPP_ENABLED=false
SAWYER_LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
# SAWYER_LLAMACPP_MODEL_PATH=/absolute/path/to/model.gguf

# --- Cloud API (disabled by default per local-safe posture) ---
# SAWYER_CLOUD_API_KEY=
SAWYER_AI_RECOMMENDATIONS=false

# --- Telemetry & Logging ---
# SAWYER_ENABLE_TELEMETRY=false
SAWYER_AUDIT_LOG=./logs/sawyer-audit.jsonl
SAWYER_REQUEST_TIMEOUT_MS=30000
SAWYER_MAX_REQUEST_BYTES=1048576
